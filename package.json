{
  "name": "vcf-design-studio",
  "private": true,
  "type": "module",
  "description": "VCF Design Studio engine and tests. The site itself is static; nothing here is served.",
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "test": "node --test \"engine/test/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "golden:record": "node engine/baseline/record.mjs",
    "build": "node --no-warnings studio/build.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "5.9.3",
    "xlsx": "npm:@e965/xlsx@0.20.3"
  }
}
